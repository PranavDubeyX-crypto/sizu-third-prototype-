
(() => {
  const API_URL = "/api/chat";

  const input = document.getElementById("messageInput");
  const sendButton = document.getElementById("sendButton");
  const chatMessages = document.getElementById("chatMessages");
  const clearButton = document.getElementById("clearChatButton");
  const connectionStatus = document.getElementById("connectionStatus");
  const statusDot = document.getElementById("statusDot");

  if (!input || !sendButton || !chatMessages) return;

  let conversation = [];
  let isSending = false;

  function setConnection(online) {
    if (connectionStatus) {
      connectionStatus.textContent = online ? "CONNECTED" : "CONNECTING";
    }

    if (statusDot) {
      statusDot.style.background = online ? "#72cba1" : "#d9ad66";
    }
  }

  function addMessage(role, text) {
    const message = document.createElement("div");
    message.className =
      role === "user"
        ? "message user-message"
        : "message assistant-message";

    if (role !== "user") {
      const avatar = document.createElement("div");
      avatar.className = "message-avatar";
      avatar.textContent = "S";
      message.appendChild(avatar);
    }

    const content = document.createElement("div");
    content.className = "message-content";

    if (role !== "user") {
      const name = document.createElement("span");
      name.className = "message-name";
      name.textContent = "SIZU";
      content.appendChild(name);
    }

    const paragraph = document.createElement("p");
    paragraph.textContent = text;

    content.appendChild(paragraph);
    message.appendChild(content);
    chatMessages.appendChild(message);

    chatMessages.scrollTop = chatMessages.scrollHeight;

    return paragraph;
  }

  function showTyping() {
    return addMessage("assistant", "SIZU is thinking...");
  }

  async function sendMessage() {
    const message = input.value.trim();

    if (!message || isSending) return;

    isSending = true;
    sendButton.disabled = true;

    addMessage("user", message);

    conversation.push({
      role: "user",
      content: message
    });

    input.value = "";

    const typingMessage = showTyping();

    window.SIZUCharacter?.setEmotion("thinking");

    try {
      const response = await fetch(API_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          messages: conversation
        })
      });

      if (!response.ok) {
        throw new Error("Server error: " + response.status);
      }

      const data = await response.json();

      const reply = data.reply;
      const emotion = data.emotion || "normal";

      if (!reply || typeof reply !== "string") {
        throw new Error("Invalid AI response");
      }

      typingMessage.textContent = reply;

      conversation.push({
        role: "assistant",
        content: reply
      });

      window.SIZUCharacter?.setEmotion(emotion);

      if (window.SIZUVoice) {
        window.SIZUVoice.speak(reply);
      }

      setConnection(true);

    } catch (error) {
      console.error("SIZU error:", error);

      typingMessage.textContent =
        "I couldn't connect to my AI brain. Please try again.";

      window.SIZUCharacter?.setEmotion("sad");
      setConnection(false);

    } finally {
      isSending = false;
      sendButton.disabled = false;
      input.focus();
    }
  }

  sendButton.addEventListener("click", sendMessage);

  input.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      sendMessage();
    }
  });

  clearButton?.addEventListener("click", () => {
    conversation = [];
    chatMessages.innerHTML = "";

    addMessage(
      "assistant",
      "New conversation started. What would you like to talk about?"
    );

    window.SIZUVoice?.stopSpeaking();
    window.SIZUCharacter?.setEmotion("normal");
  });

  // Initial connection indicator
  setConnection(false);

  console.log("SIZU 2.0 frontend initialized.");
})();
