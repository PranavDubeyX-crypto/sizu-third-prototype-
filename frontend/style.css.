
:root {
  --bg: #080b10;
  --panel: #10151d;
  --panel-light: #171e29;
  --text: #edf2f8;
  --muted: #8491a2;
  --accent: #9ebbd6;
  --border: rgba(180, 205, 230, 0.13);
  --glow: rgba(95, 158, 220, 0.2);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% 35%, #172333 0%, transparent 48%),
    var(--bg);
  color: var(--text);
  font-family: Inter, system-ui, sans-serif;
}

button, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  min-height: 100vh;
  max-width: 1600px;
  margin: auto;
  padding: 0 5%;
  display: flex;
  flex-direction: column;
}

.topbar {
  height: 82px;
  display: flex;
  align-items: center;
  gap: 18px;
  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-right: auto;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid #8ca9c4;
  border-radius: 12px;
  color: #dcecff;
  font-size: 23px;
  font-weight: 800;
  box-shadow: 0 0 22px var(--glow);
}

.brand h1 {
  font-size: 19px;
  letter-spacing: 4px;
}

.brand span,
.character-heading,
.eyebrow,
.input-footer,
.character-status {
  font-size: 9px;
  letter-spacing: 2px;
  color: var(--muted);
}

.connection {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  letter-spacing: 1px;
  color: var(--muted);
}

.status-dot {
  width: 7px;
  height: 7px;
  display: inline-block;
  border-radius: 50%;
  background: #72cba1;
  box-shadow: 0 0 10px #72cba1;
}

.icon-button,
.tool-button {
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--text);
  border-radius: 10px;
  width: 40px;
  height: 40px;
}

.main-layout {
  flex: 1;
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  gap: 5%;
  padding: 45px 0;
}

.character-section,
.assistant-section {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.character-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.version {
  color: var(--accent);
}

.character-stage {
  flex: 1;
  min-height: 430px;
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
  background:
    radial-gradient(ellipse, rgba(71, 111, 150, 0.16), transparent 65%);
}

.character-glow {
  position: absolute;
  bottom: 9%;
  width: 220px;
  height: 30px;
  border-radius: 50%;
  background: var(--glow);
  filter: blur(22px);
}

.character {
  position: relative;
  z-index: 1;
  width: 100%;
  display: grid;
  place-items: center;
}

.character-info {
  text-align: center;
  padding: 10px 0 24px;
}

.character-info h2 {
  font-size: 25px;
  letter-spacing: 7px;
}

.character-info p {
  margin: 8px 0;
  font-size: 10px;
  letter-spacing: 2px;
  color: var(--accent);
}

.character-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.assistant-section {
  min-height: 580px;
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: rgba(16, 21, 29, 0.78);
  backdrop-filter: blur(18px);
}

.conversation-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--border);
}

.conversation-header h2 {
  margin-top: 7px;
  font-size: 21px;
}

.text-button {
  border: none;
  background: transparent;
  color: var(--accent);
  font-size: 10px;
  letter-spacing: 1px;
}

.chat-messages {
  flex: 1;
  min-height: 300px;
  max-height: 480px;
  overflow-y: auto;
  padding: 24px 0;
}

.message {
  display: flex;
  gap: 12px;
  margin-bottom: 22px;
}

.message-avatar {
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border);
  border-radius: 9px;
  color: var(--accent);
  background: var(--panel-light);
}

.message-content {
  min-width: 0;
}

.message-name {
  font-size: 10px;
  letter-spacing: 1px;
  color: var(--accent);
}

.message-content p {
  margin-top: 7px;
  font-size: 14px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.user-message {
  justify-content: flex-end;
}

.user-message .message-content {
  max-width: 82%;
  padding: 12px 15px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--panel-light);
}

.input-area {
  padding-top: 15px;
  border-top: 1px solid var(--border);
}

.input-tools {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 12px;
  font-size: 9px;
  letter-spacing: 1px;
  color: var(--muted);
}

.message-input-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: #0a0e14;
}

.message-input-row textarea {
  flex: 1;
  min-width: 0;
  resize: none;
  max-height: 120px;
  border: none;
  outline: none;
  background: transparent;
  color: var(--text);
  font-size: 14px;
  padding: 8px;
}

.message-input-row textarea::placeholder {
  color: #687588;
}

.send-button {
  width: 40px;
  height: 40px;
  border: none;
  border-radius: 10px;
  background: #b5cde4;
  color: #101722;
  font-size: 20px;
}

.input-footer,
.footer {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin-top: 13px;
  font-size: 8px;
  letter-spacing: 1px;
}

.footer {
  padding: 20px 0;
  border-top: 1px solid var(--border);
  color: var(--muted);
}

@media (max-width: 800px) {
  .app {
    padding: 0 18px;
  }

  .topbar {
    height: 70px;
  }

  .main-layout {
    grid-template-columns: 1fr;
    gap: 15px;
    padding: 25px 0;
  }

  .character-stage {
    min-height: 310px;
  }

  .assistant-section {
    min-height: 550px;
    padding: 18px;
  }

  .chat-messages {
    min-height: 280px;
  }
}

@media (max-width: 380px) {
  .connection {
    font-size: 8px;
  }

  .brand h1 {
    font-size: 16px;
  }

  .assistant-section {
    padding: 14px;
  }
}
